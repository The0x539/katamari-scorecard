{
  "tasks": {
    "dump": "deno -R src/dump-strings.ts > src/strings.json",
    "build": "deno bundle src/index.html --outdir dist",
    "serve": "deno run -R -N jsr:@std/http/file-server dist",
  },
  "imports": {
    "@preact/signals": "npm:@preact/signals@^2.5.1",
    "@std/fs": "jsr:@std/fs@^1.0.20",
    "preact": "npm:preact@^10.28.0",
  },
  "compilerOptions": {
    "module": "esnext",
    "strict": true,

    "jsx": "react-jsx",
    "jsxImportSource": "preact",
  }
}
