{
  "nodeModulesDir": "auto",
  "tasks": {
    "dump-locale": "deno -R src/dump-strings.ts king_text > src/game-data/locale.json",
    "dump-missions": "deno -R src/dump-strings.ts mission > src/game-data/missions.json",
    "dump-things": "deno -R src/dump-strings.ts mononame > src/game-data/things.json",
    "dump": "deno task dump-locale && deno task dump-missions && deno task dump-things",

    "build": "deno run -A npm:@rsbuild/core build",
    "run": "deno run -A npm:@rsbuild/core dev",

    "deploy": "deno task build --base /~the0x539/katamari && rsync -r dist/ lcolonq:public_html/katamari"
  },
  "imports": {
    "@preact/signals": "npm:@preact/signals@^2.5.1",
    "@rsbuild/core": "npm:@rsbuild/core@^1.6.15",
    "@rsbuild/plugin-preact": "npm:@rsbuild/plugin-preact@^1.6.0",
    "@rsbuild/plugin-type-check": "npm:@rsbuild/plugin-type-check@^1.3.2",
    "@std/fs": "jsr:@std/fs@^1.0.20",
    "preact": "npm:preact@^10.28.0",
    "preact-transitioning": "npm:preact-transitioning@^1.5.3",
    "temporal-polyfill": "npm:temporal-polyfill@^0.3.0",
    "typescript": "npm:typescript@^5.9.3"
  },
  "lint": {
    "rules": {
      "exclude": ["no-window"]
    }
  },
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "types": ["./src/global.d.ts"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  }
}
